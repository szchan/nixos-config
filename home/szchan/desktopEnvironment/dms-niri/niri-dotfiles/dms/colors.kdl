layout {
    background-color "transparent"

    focus-ring {
        active-color   "#8f4a4c"
        inactive-color "#857373"
        urgent-color   "#ba1a1a"
    }

    border {
        active-color   "#8f4a4c"
        inactive-color "#857373"
        urgent-color   "#ba1a1a"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#8f4a4c"
        inactive-color "#857373"
        urgent-color   "#ba1a1a"
    }

    insert-hint {
        color "#8f4a4c80"
    }
}

recent-windows {
    highlight {
        active-color   "#733336"
        urgent-color   "#ba1a1a"
    }
}